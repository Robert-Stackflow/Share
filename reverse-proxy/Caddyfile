:3000 {
	root * /opt/app/frontend/public

	@page {
		not path /api/* /_next/* /img/* /brand/* /manifest.json /sw.js /workbox-*.js /*.*
	}
	forward_auth @page http://localhost:{$BACKEND_PORT:8080} {
		uri /api/frontend-route
	}

	# API and short-link visits remain dynamic and are handled by NestJS.
	reverse_proxy /api/* http://localhost:{$BACKEND_PORT:8080}
	@short path_regexp short ^/s/([^/]+)/?$
	route @short {
		rewrite * /api/short-links/{re.short.1}/open
		reverse_proxy http://localhost:{$BACKEND_PORT:8080}
	}

	# Other dynamic routes use an exported placeholder page.
	@resetPassword path_regexp resetPassword ^/auth/resetPassword/[^/]+/?$
	rewrite @resetPassword /auth/resetPassword/_/
	@totp path_regexp totp ^/auth/totp/[^/]+/?$
	rewrite @totp /auth/totp/_/
	@room path_regexp room ^/rooms/[^/]+/?$
	rewrite @room /rooms/_/
	@inbox path_regexp inbox ^/inbox/[^/]+/?$
	rewrite @inbox /inbox/_/
	@shareEdit path_regexp shareEdit ^/share/[^/]+/edit/?$
	rewrite @shareEdit /share/_/edit/
	@share path_regexp share ^/share/[^/]+/?$
	rewrite @share /share/_/
	@shortLinkAdmin path_regexp shortLinkAdmin ^/short-links/[^/]+/?$
	rewrite @shortLinkAdmin /short-links/_/
	@reverseShare path_regexp reverseShare ^/upload/[^/]+/?$
	rewrite @reverseShare /upload/_/

	file_server
}
